rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // غيّر الإيميل ده لإيميلك (نفس الحساب اللي هتسجله في Firebase Authentication)
    function admin(){ return request.auth != null && request.auth.token.email == 'YOUR_EMAIL@gmail.com'; }
    match /exams/{id}      { allow read: if resource.data.active == true || admin(); allow write: if admin(); }
    match /examKeys/{id}   { allow read, write: if admin(); }
    match /submissions/{id}{ allow create: if request.resource.data.keys().hasAll(['examId','name','email','answers','code']); allow read, update, delete: if admin(); }
    match /results/{code}  { allow get: if true; allow list, write: if admin(); }
  }
}
